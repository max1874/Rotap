{
  "sourceLanguage": "en",
  "strings": {
    "%@ (playing)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（正在发声）"
          }
        }
      }
    },
    "%@ + Microphone": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ + 麦克风"
          }
        }
      }
    },
    "%@ failed (%@)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@失败（%2$@）"
          }
        }
      }
    },
    "All System Audio": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部系统声音"
          }
        }
