      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解析 Tap 音频格式"
          }
        }
      }
    },
    "Record": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音"
          }
        }
      }
    },
