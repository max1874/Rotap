    },
    "Pause": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停"
          }
        }
      }
    },
    "Permissions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限"
          }
        }
      }
    },
    "Pick a source and start recording. Rotap just listens in and never changes your speaker or headphone output.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择来源后开始录音。Rotap 只在旁边聆听，不改变你的扬声器或耳机输出。"
          }
        }
      }
    },
    "Play": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放"
          }
        }
      }
    },
    "Preparing the audio buffer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备音频缓冲"
          }
        }
      }
    },
    "Reading an audio property": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取音频属性"
          }
        }
      }
    },
    "Reading audio objects": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取音频对象列表"
