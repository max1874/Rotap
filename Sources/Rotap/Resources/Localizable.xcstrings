          }
        }
      }
    },
    "Restart Now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即重启"
          }
        }
      }
    },
    "Restart Rotap to switch the language.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启 Rotap 后切换语言。"
          }
        }
      }
    },
    "Restore Default": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复默认"
          }
        }
      }
    },
    "Rotap": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotap"
          }
        }
      }
    },
    "Rotap doesn’t have access to the microphone. Allow Rotap in System Settings › Privacy & Security › Microphone, or switch to System Audio Only.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotap 没有麦克风权限。请在「系统设置 › 隐私与安全性 › 麦克风」中允许 Rotap，或改为「仅系统声音」。"
          }
        }
      }
    },
    "Save Location": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存位置"
          }
        }
      }
    },
    "Search Recordings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索录音"
          }
        }
      }
    },
    "Show in Finder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中显示"
          }
        }
      }
    },
